<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:c="clr-namespace:QuizSante.Controls" xmlns:h="clr-namespace:QuizSante.Helpers" x:Class="QuizSante.Pages.ForgotPasswordPage">
    <Grid RowDefinitions="Auto,*">
        <c:BackHeader Title="Mot De Passe Oublié" BackRoute="login" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="22,14,22,28" Spacing="0">
                <Grid ColumnDefinitions="Auto,*">
                    <Border WidthRequest="46" HeightRequest="46" StrokeThickness="0" StrokeShape="RoundRectangle 23"
                            BackgroundColor="{StaticResource SecondaryContainer}" h:Nav.To="login">
                        <c:Ico Name="chevron-left" Size="26" TextColor="{StaticResource OnSurface}" />
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Chip}" BackgroundColor="{StaticResource SurfaceContainer}"
                            HorizontalOptions="End" VerticalOptions="Center" Padding="10,6">
                        <HorizontalStackLayout Spacing="6">
                            <BoxView WidthRequest="9" HeightRequest="9" CornerRadius="5" Color="{StaticResource Green}" VerticalOptions="Center" />
                            <Label Text="ESPACE SÉCURISÉ" FontFamily="InterBold" FontSize="12.5" TextColor="{StaticResource PrimaryDark}" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <Grid HorizontalOptions="Center" Margin="0,18,0,18" WidthRequest="150" HeightRequest="150">
                    <Border WidthRequest="150" HeightRequest="150" StrokeThickness="0" StrokeShape="RoundRectangle 75" BackgroundColor="{StaticResource SecondaryContainer}" />
                    <Border WidthRequest="100" HeightRequest="100" StrokeThickness="0" StrokeShape="RoundRectangle 50" BackgroundColor="{StaticResource PrimaryContainer}" />
                    <c:Ico Name="lock-reset" Size="48" TextColor="{StaticResource PrimaryDark}" />
                    <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 22" BackgroundColor="{StaticResource PrimaryDark}"
                            HorizontalOptions="End" VerticalOptions="End" Margin="0,0,14,18">
                        <c:Ico Name="key-variant" Size="22" TextColor="White" />
                    </Border>
                </Grid>

                <Label Text="Mot de passe oublié ?" FontFamily="InterXBold" FontSize="29" TextColor="{StaticResource PrimaryDark}" HorizontalTextAlignment="Center" />
                <Label Text="Entrez votre adresse email. Nous vous enverrons un code de réinitialisation sécurisé."
                       FontSize="16" TextColor="{StaticResource OnSurfaceVariant}" HorizontalTextAlignment="Center" Margin="8,8,8,22" />

                <Border Style="{StaticResource Card}" Padding="18">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Adresse email associée" FontFamily="InterBold" FontSize="14" Margin="0,0,0,8" />
                        <c:InputField Icon="email-outline" Placeholder="docteur.dupont@exemple.fr" KeyboardType="Email" />
                        <Border Style="{StaticResource PrimaryButton}" Margin="0,28,0,0" Opacity="0.55" h:Nav.To="verify">
                            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                <c:Ico Name="send-outline" Size="20" TextColor="White" />
                                <Label Text="Envoyer le lien de réinitialisation" FontFamily="InterBold" FontSize="16" TextColor="White" />
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource SurfaceContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="18,16" Margin="0,22,0,0" MinimumHeightRequest="110">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowDefinitions="Auto,Auto">
                        <c:Ico Name="lightbulb-outline" Size="18" TextColor="{StaticResource OnSurface}" VerticalOptions="Start" />
                        <Label Grid.Column="1" Text="Conseil" FontFamily="InterBold" FontSize="14.5" />
                        <Label Grid.Row="1" Grid.Column="1" Text="Vérifiez également votre dossier de courriers indésirables (spams) si le message tarde à arriver."
                               FontSize="14" TextColor="{StaticResource OnSurfaceVariant}" />
                    </Grid>
                </Border>

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8" Margin="0,28,0,0" h:Nav.To="login">
                    <c:Ico Name="arrow-left" Size="20" TextColor="{StaticResource PrimaryDark}" />
                    <Label Text="Retourner à la page de connexion" FontFamily="InterBold" FontSize="15.5" TextColor="{StaticResource PrimaryDark}" />
                </HorizontalStackLayout>

                <BoxView WidthRequest="60" HeightRequest="3" CornerRadius="2" Color="{StaticResource SecondaryContainer}" Margin="0,22,0,14" />
                <Label Text="Besoin d'aide ?" FontSize="14" TextColor="{StaticResource OnSurfaceVariant}" HorizontalTextAlignment="Center" />
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,4,0,0">
                    <c:Ico Name="help-circle-outline" Size="18" TextColor="{StaticResource Indigo}" />
                    <Label Text="Contacter le support médical &amp; technique" FontFamily="InterSemi" FontSize="14" TextColor="{StaticResource Indigo}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
