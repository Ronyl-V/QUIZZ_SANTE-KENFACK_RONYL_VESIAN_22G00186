<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:c="clr-namespace:QuizSante.Controls" xmlns:h="clr-namespace:QuizSante.Helpers" x:Class="QuizSante.Pages.ProfilePage">
    <Grid RowDefinitions="Auto,*,Auto">
        <c:BrandHeader />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,14,18,24" Spacing="16">

                <!-- Carte profil -->
                <Border Style="{StaticResource Card}" Padding="18" StrokeShape="RoundRectangle 22">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Grid WidthRequest="82" HeightRequest="82">
                                <Border WidthRequest="70" HeightRequest="70" StrokeThickness="0" StrokeShape="RoundRectangle 35" HorizontalOptions="Start" VerticalOptions="Start">
                                    <Image Source="avatar.png" Aspect="AspectFill" />
                                </Border>
                                <Border WidthRequest="30" HeightRequest="30" StrokeThickness="2" Stroke="White" StrokeShape="RoundRectangle 15" BackgroundColor="{StaticResource Mint}" HorizontalOptions="End" VerticalOptions="End">
                                    <c:Ico Name="check-decagram-outline" Size="18" TextColor="{StaticResource OnMint}" />
                                </Border>
                            </Grid>
                            <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                <Label Text="Thomas Dupont" FontFamily="InterBold" FontSize="22" />
                                <HorizontalStackLayout Spacing="10">
                                    <Border Style="{StaticResource Chip}" BackgroundColor="{StaticResource PrimaryContainer}" Padding="11,7">
                                        <Label Text="Secouriste Citoyen" FontFamily="InterBold" FontSize="13" TextColor="{StaticResource OnPrimaryContainer}" />
                                    </Border>
                                    <Label Text="Membre depuis 2026" FontSize="13.5" TextColor="{StaticResource OnSurfaceVariant}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                        <Border BackgroundColor="{StaticResource SurfaceContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="14,14">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <BoxView WidthRequest="11" HeightRequest="11" CornerRadius="6" Color="#4ADE80" VerticalOptions="Start" Margin="0,6,0,0" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Synchronisé sur cet appareil" FontFamily="InterBold" FontSize="14.5" />
                                    <Label Text="Compte certifié • Mode connecté" FontSize="14" TextColor="{StaticResource OnSurfaceVariant}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="Modifier" FontFamily="InterBold" FontSize="14.5" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Mode hors-ligne -->
                <Border Style="{StaticResource Card}" Padding="18" StrokeShape="RoundRectangle 22">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="#E1E4FF">
                                <c:Ico Name="cloud-check-outline" Size="26" TextColor="{StaticResource PrimaryDark}" />
                            </Border>
                            <Label Grid.Column="1" Text="Mode Hors-ligne" FontFamily="InterBold" FontSize="19" VerticalOptions="Center" />
                            <Border Grid.Column="2" Style="{StaticResource Chip}" BackgroundColor="{StaticResource SecondaryContainer}" Padding="11,7" VerticalOptions="Center">
                                <Label Text="Optimal" FontFamily="InterBold" FontSize="13.5" TextColor="{StaticResource Indigo}" />
                            </Border>
                        </Grid>
                        <Border BackgroundColor="{StaticResource SurfaceContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="14">
                            <VerticalStackLayout Spacing="9">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Stockage fiches &amp; gestes" FontSize="14.5" />
                                    <Label Grid.Column="1" Text="48 Mo / 120 Mo" FontFamily="InterBold" FontSize="14.5" TextColor="{StaticResource Primary}" />
                                </Grid>
                                <c:Bar Progress="0.40" FillColor="{StaticResource Primary}" TrackColor="{StaticResource SecondaryContainer}" HeightRequest="10" />
                                <Label Text="Données d'urgence toujours disponibles sans connexion réseau." FontSize="13.5" TextColor="{StaticResource Outline}" />
                            </VerticalStackLayout>
                        </Border>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Télécharger uniquement en Wi-Fi" FontSize="16" />
                                <Label Text="Préserve votre forfait de données mobiles" FontSize="13.5" TextColor="{StaticResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="True" VerticalOptions="Center" />
                        </Grid>
                        <Border BackgroundColor="{StaticResource SurfaceContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="14,15">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <c:Ico Name="download-circle-outline" Size="24" TextColor="{StaticResource OnSurfaceVariant}" />
                                <Label Grid.Column="1" Text="Gérer les 16 thèmes téléchargés" FontFamily="InterBold" FontSize="15" VerticalOptions="Center" />
                                <c:Ico Grid.Column="2" Name="chevron-right" Size="22" TextColor="{StaticResource OnSurfaceVariant}" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Urgences & vigilance -->
                <Border Style="{StaticResource Card}" Padding="18" StrokeShape="RoundRectangle 22">
                    <VerticalStackLayout Spacing="14">
                        <HorizontalStackLayout Spacing="12">
                            <Border WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource ErrorContainer}">
                                <c:Ico Name="alarm-light-outline" Size="26" TextColor="{StaticResource Error}" />
                            </Border>
                            <Label Text="Urgences &amp; Vigilance" FontFamily="InterBold" FontSize="19" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border BackgroundColor="{StaticResource SurfaceContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="14">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="4">
                                    <HorizontalStackLayout Spacing="6">
                                        <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="{StaticResource Error}" VerticalOptions="Center" />
                                        <Label Text="Numéros configurés" FontFamily="InterBold" FontSize="14" TextColor="{StaticResource Error}" />
                                    </HorizontalStackLayout>
                                    <Label Text="15 (SAMU) • 112 (Europe)" FontFamily="InterBold" FontSize="18" />
                                    <Label Text="Déclenchement direct depuis le bandeau d'alerte" FontSize="13.5" TextColor="{StaticResource OnSurfaceVariant}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="16,11" VerticalOptions="Start">
                                    <Label Text="Modifier" FontFamily="InterBold" FontSize="14" TextColor="{StaticResource PrimaryDark}" />
                                </Border>
                            </Grid>
                        </Border>
                        <Border BackgroundColor="{StaticResource SurfaceContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="14">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="RoundRectangle 24" BackgroundColor="{StaticResource PrimaryContainer}">
                                    <c:Ico Name="alarm" Size="24" TextColor="{StaticResource PrimaryDark}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Rappel bienveillant quotidien" FontFamily="InterBold" FontSize="14.5" />
                                    <Label Text="18h30 • « Une minute pour un geste »" FontSize="14" TextColor="{StaticResource OnSurfaceVariant}" />
                                </VerticalStackLayout>
                                <c:Ico Grid.Column="2" Name="clock-outline" Size="24" TextColor="{StaticResource PrimaryDark}" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Accessibilité -->
                <Border Style="{StaticResource Card}" Padding="18" StrokeShape="RoundRectangle 22">
                    <VerticalStackLayout Spacing="12">
                        <HorizontalStackLayout Spacing="12">
                            <Border WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource SecondaryContainer}">
                                <c:Ico Name="eye-outline" Size="26" TextColor="{StaticResource OnSurfaceVariant}" />
                            </Border>
                            <Label Text="Accessibilité &amp; Affichage" FontFamily="InterBold" FontSize="19" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Label Text="Taille du texte de lecture" FontSize="14.5" TextColor="{StaticResource OnSurfaceVariant}" Margin="0,6,0,0" />
                        <Border BackgroundColor="{StaticResource SurfaceContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="5">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="4" HeightRequest="42">
                                <Border x:Name="TextNormal" StrokeThickness="0" StrokeShape="RoundRectangle 11" BackgroundColor="White">
                                    <Label x:Name="TextNormalLbl" Text="Normale (A)" FontFamily="InterBold" FontSize="14.5" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTextSizeTapped" CommandParameter="0" /></Border.GestureRecognizers>
                                </Border>
                                <Border x:Name="TextLarge" Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 11" BackgroundColor="Transparent">
                                    <Label x:Name="TextLargeLbl" Text="Grande (A+)" FontFamily="InterBold" FontSize="14.5" TextColor="{StaticResource OnSurfaceVariant}" HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTextSizeTapped" CommandParameter="1" /></Border.GestureRecognizers>
                                </Border>
                            </Grid>
                        </Border>

                        <Label Text="Thème de l'interface" FontSize="14.5" TextColor="{StaticResource OnSurfaceVariant}" Margin="0,6,0,0" />
                        <Border BackgroundColor="{StaticResource SurfaceContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="5">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="4" HeightRequest="42">
                                <Border x:Name="ThemeLight" StrokeThickness="0" StrokeShape="RoundRectangle 11" BackgroundColor="White">
                                    <HorizontalStackLayout Spacing="7" HorizontalOptions="Center" VerticalOptions="Center">
                                        <c:Ico x:Name="ThemeLightIcon" Name="white-balance-sunny" Size="19" TextColor="{StaticResource Primary}" />
                                        <Label x:Name="ThemeLightLbl" Text="Clair (Actif)" FontFamily="InterBold" FontSize="14.5" TextColor="{StaticResource Primary}" />
                                    </HorizontalStackLayout>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnThemeTapped" CommandParameter="0" /></Border.GestureRecognizers>
                                </Border>
                                <Border x:Name="ThemeDark" Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 11" BackgroundColor="Transparent">
                                    <HorizontalStackLayout Spacing="7" HorizontalOptions="Center" VerticalOptions="Center">
                                        <c:Ico x:Name="ThemeDarkIcon" Name="weather-night" Size="19" TextColor="{StaticResource OnSurfaceVariant}" />
                                        <Label x:Name="ThemeDarkLbl" Text="Sombre" FontFamily="InterBold" FontSize="14.5" TextColor="{StaticResource OnSurfaceVariant}" />
                                    </HorizontalStackLayout>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnThemeTapped" CommandParameter="1" /></Border.GestureRecognizers>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,6,0,0">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Contraste renforcé (WCAG AAA)" FontSize="16" />
                                <Label Text="Lisibilité accrue sous lumière vive" FontSize="13.5" TextColor="{StaticResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="False" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Confidentialité -->
                <Border Style="{StaticResource Card}" Padding="18" StrokeShape="RoundRectangle 22">
                    <VerticalStackLayout Spacing="14">
                        <HorizontalStackLayout Spacing="12">
                            <Border WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource Green}">
                                <c:Ico Name="shield-plus" Size="26" TextColor="White" />
                            </Border>
                            <Label Text="Confidentialité &amp; Déontologie" FontFamily="InterBold" FontSize="19" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border BackgroundColor="{StaticResource SurfaceContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="14">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <c:Ico Name="lock-outline" Size="22" TextColor="{StaticResource Green}" VerticalOptions="Start" />
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="Données strictement locales (RGPD)" FontFamily="InterBold" FontSize="14.5" />
                                    <Label Text="Vos scores, historiques de quiz et fiches consultées sont stockés uniquement sur votre téléphone. Aucun identifiant médical n'est transmis à des serveurs tiers."
                                           FontSize="14" TextColor="{StaticResource OnSurfaceVariant}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                        <Border BackgroundColor="{StaticResource SecondaryContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="14">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <c:Ico Name="information-outline" Size="22" TextColor="{StaticResource OnSurfaceVariant}" VerticalOptions="Start" />
                                <Label Grid.Column="1" FontSize="14" TextColor="{StaticResource OnSurfaceVariant}">
                                    <Label.FormattedText><FormattedString>
                                        <Span Text="Avertissement légal : " FontFamily="InterBold" TextColor="{StaticResource OnSurface}" />
                                        <Span Text="QuizSanté est un outil d'entraînement préventif et d'apprentissage ludique. Il ne remplace en aucun cas une formation certifiante aux premiers secours (PSC1, SST) ni l'avis d'un professionnel de santé." />
                                    </FormattedString></Label.FormattedText>
                                </Label>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource SurfaceContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 18" HeightRequest="56" h:Nav.To="login">
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                        <c:Ico Name="logout" Size="22" TextColor="{StaticResource OnSurface}" />
                        <Label Text="Se déconnecter" FontFamily="InterBold" FontSize="16.5" />
                    </HorizontalStackLayout>
                </Border>
                <Border BackgroundColor="{StaticResource ErrorSoft}" StrokeThickness="0" StrokeShape="RoundRectangle 18" HeightRequest="54">
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                        <c:Ico Name="restart" Size="21" TextColor="{StaticResource OnError}" />
                        <Label Text="Réinitialiser mes données locales d'apprentissage" FontFamily="InterBold" FontSize="14" TextColor="{StaticResource OnError}" />
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <c:BottomNav Grid.Row="2" Active="profile" />
    </Grid>
</ContentPage>
