<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:c="clr-namespace:QuizSante.Controls" xmlns:h="clr-namespace:QuizSante.Helpers" x:Class="QuizSante.Pages.ProgressPage">
    <Grid RowDefinitions="Auto,*,Auto">
        <c:BrandHeader />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,14,18,24" Spacing="16">

                <!-- Carte niveau -->
                <Border Background="{StaticResource HeroGradient}" StrokeThickness="0" StrokeShape="RoundRectangle 24" Padding="18">
                    <Border.Shadow><Shadow Brush="#0B1C30" Opacity="0.07" Radius="14" Offset="0,5" /></Border.Shadow>
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Grid WidthRequest="84" HeightRequest="84">
                                <Border WidthRequest="74" HeightRequest="74" StrokeThickness="0" StrokeShape="RoundRectangle 20" BackgroundColor="{StaticResource Primary}" HorizontalOptions="Start" VerticalOptions="Start">
                                    <c:Ico Name="medal" Size="40" TextColor="White" />
                                </Border>
                                <Border BackgroundColor="{StaticResource Green}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="9,3" HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,6,2">
                                    <Label Text="Nv.4" FontFamily="InterBold" FontSize="13" TextColor="White" />
                                </Border>
                            </Grid>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Bonjour, Thomas" FontFamily="InterBold" FontSize="23" />
                                <Label Text="Secouriste Averti" FontFamily="InterBold" FontSize="16" TextColor="{StaticResource Primary}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center" HorizontalOptions="End">
                                <Label Text="RANG RÉGIONAL" FontFamily="InterBold" FontSize="12.5" TextColor="{StaticResource OnSurfaceVariant}" CharacterSpacing="0.8" HorizontalTextAlignment="End" />
                                <Label Text="Top 8%" FontFamily="InterXBold" FontSize="24" TextColor="{StaticResource Indigo}" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Grid>
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <HorizontalStackLayout Spacing="6">
                                    <c:Ico Name="lightning-bolt" Size="17" TextColor="{StaticResource Primary}" />
                                    <Label Text="Progression Niveau 5" FontFamily="InterBold" FontSize="14" />
                                </HorizontalStackLayout>
                                <Label Grid.Column="1" FontSize="14">
                                    <Label.FormattedText><FormattedString>
                                        <Span Text="850" FontFamily="InterBold" TextColor="{StaticResource Primary}" />
                                        <Span Text=" / 1000 XP" TextColor="{StaticResource OnSurfaceVariant}" />
                                    </FormattedString></Label.FormattedText>
                                </Label>
                            </Grid>
                            <c:Bar Progress="0.85" FillBrush="{StaticResource XpGradient}" TrackColor="{StaticResource TrackBlue}" HeightRequest="12" />
                            <Label HorizontalTextAlignment="Center" FontSize="14.5" TextColor="{StaticResource OnSurfaceVariant}">
                                <Label.FormattedText><FormattedString>
                                    <Span Text="Plus que 150 XP pour débloquer " />
                                    <Span Text="Instructeur Relais" FontFamily="InterBold" TextColor="{StaticResource OnSurface}" />
                                </FormattedString></Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- 3 statistiques -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Border Style="{StaticResource Card}" Padding="14" StrokeShape="RoundRectangle 18">
                        <VerticalStackLayout Spacing="6">
                            <Border WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource PrimaryContainer}" HorizontalOptions="Start">
                                <c:Ico Name="trophy" Size="24" TextColor="{StaticResource PrimaryDark}" />
                            </Border>
                            <Label Text="18" FontFamily="InterXBold" FontSize="26" Margin="0,6,0,0" />
                            <Label Text="Quiz réussis" FontFamily="InterBold" FontSize="14" />
                            <HorizontalStackLayout Spacing="4">
                                <c:Ico Name="arrow-up" Size="14" TextColor="{StaticResource Green}" VerticalOptions="Start" />
                                <Label Text="+3 cette sem." FontSize="12.5" TextColor="{StaticResource Green}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14" StrokeShape="RoundRectangle 18">
                        <VerticalStackLayout Spacing="6">
                            <Border WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource OrangeSoft}" HorizontalOptions="Start">
                                <c:Ico Name="fire" Size="24" TextColor="{StaticResource Orange}" />
                            </Border>
                            <Label Text="5 j" FontFamily="InterXBold" FontSize="26" Margin="0,6,0,0" />
                            <Label Text="Série active" FontFamily="InterBold" FontSize="14" />
                            <HorizontalStackLayout Spacing="4" Margin="0,6,0,0">
                                <BoxView WidthRequest="9" HeightRequest="9" CornerRadius="5" Color="{StaticResource Orange}" />
                                <BoxView WidthRequest="9" HeightRequest="9" CornerRadius="5" Color="{StaticResource Orange}" />
                                <BoxView WidthRequest="9" HeightRequest="9" CornerRadius="5" Color="{StaticResource Orange}" />
                                <BoxView WidthRequest="9" HeightRequest="9" CornerRadius="5" Color="{StaticResource Orange}" />
                                <BoxView WidthRequest="9" HeightRequest="9" CornerRadius="5" Color="{StaticResource Orange}" />
                                <BoxView WidthRequest="9" HeightRequest="9" CornerRadius="5" Color="{StaticResource TrackBlue}" />
                                <BoxView WidthRequest="9" HeightRequest="9" CornerRadius="5" Color="{StaticResource TrackBlue}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14" StrokeShape="RoundRectangle 18">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="#C9F6DA">
                                    <c:Ico Name="check-decagram-outline" Size="24" TextColor="{StaticResource GreenText}" />
                                </Border>
                                <c:RingView Grid.Column="1" WidthRequest="40" HeightRequest="40" Progress="0.89" Thickness="5" ArcColor="#0F9D58" TrackColor="#C9F6DA" HorizontalOptions="End" VerticalOptions="Start" />
                            </Grid>
                            <Label Text="89%" FontFamily="InterXBold" FontSize="26" Margin="0,6,0,0" />
                            <Label Text="Score moyen" FontFamily="InterBold" FontSize="14" />
                            <HorizontalStackLayout Spacing="4">
                                <c:Ico Name="trending-up" Size="15" TextColor="{StaticResource Green}" />
                                <Label Text="Compétent" FontSize="12.5" TextColor="{StaticResource Green}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Activité de la semaine -->
                <Border Style="{StaticResource Card}" Padding="18" StrokeShape="RoundRectangle 22">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Activité de la semaine" FontFamily="InterBold" FontSize="19" />
                                <Label Text="140 XP cumulés • 6 quiz complétés" FontSize="13.5" TextColor="{StaticResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" Style="{StaticResource Chip}" BackgroundColor="{StaticResource PrimaryContainer}" Padding="12,8" VerticalOptions="Start">
                                <Label Text="Sem. 42" FontFamily="InterBold" FontSize="13.5" TextColor="{StaticResource OnPrimaryContainer}" />
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="14" RowDefinitions="Auto,150,Auto" RowSpacing="6" Margin="4,6,4,0">
                            <!-- étiquettes de valeur -->
                            <Label Grid.Column="4" Text="50pt" FontFamily="InterBold" FontSize="12" TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="5" Text="--" FontSize="12" TextColor="{StaticResource Outline}" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="6" Text="--" FontSize="12" TextColor="{StaticResource Outline}" HorizontalTextAlignment="Center" />

                            <!-- colonnes -->
                            <Border Grid.Row="1" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource SecondaryContainer}">
                                <Grid RowDefinitions="0.65*,0.35*"><BoxView Grid.Row="1" Color="{StaticResource BarBlue}" /></Grid>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource SecondaryContainer}">
                                <Grid RowDefinitions="0.35*,0.65*"><BoxView Grid.Row="1" Color="{StaticResource BarBlue}" /></Grid>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource SecondaryContainer}">
                                <Grid RowDefinitions="0.55*,0.45*"><BoxView Grid.Row="1" Color="{StaticResource BarBlue}" /></Grid>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="3" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource SecondaryContainer}">
                                <Grid RowDefinitions="0.14*,0.86*"><BoxView Grid.Row="1" Color="{StaticResource BarBlue}" /></Grid>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="4" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource PrimaryContainer}">
                                <Grid RowDefinitions="0.25*,0.75*"><BoxView Grid.Row="1" Color="{StaticResource Primary}" /></Grid>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="5" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource SurfaceContainer}" />
                            <Border Grid.Row="1" Grid.Column="6" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource SurfaceContainer}" />

                            <!-- jours -->
                            <Label Grid.Row="2" Text="L" FontFamily="InterBold" FontSize="13.5" HorizontalTextAlignment="Center" />
                            <Label Grid.Row="2" Grid.Column="1" Text="M" FontFamily="InterBold" FontSize="13.5" HorizontalTextAlignment="Center" />
                            <Label Grid.Row="2" Grid.Column="2" Text="M" FontFamily="InterBold" FontSize="13.5" HorizontalTextAlignment="Center" />
                            <Label Grid.Row="2" Grid.Column="3" Text="J" FontFamily="InterBold" FontSize="13.5" HorizontalTextAlignment="Center" />
                            <Label Grid.Row="2" Grid.Column="4" Text="V" FontFamily="InterBold" FontSize="13.5" TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" />
                            <Label Grid.Row="2" Grid.Column="5" Text="S" FontFamily="InterBold" FontSize="13.5" TextColor="{StaticResource Outline}" HorizontalTextAlignment="Center" />
                            <Label Grid.Row="2" Grid.Column="6" Text="D" FontFamily="InterBold" FontSize="13.5" TextColor="{StaticResource Outline}" HorizontalTextAlignment="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Points à revoir -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="❗" FontSize="17" VerticalOptions="Center" />
                        <Label Text="Points à revoir en priorité" FontFamily="InterBold" FontSize="19" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Grid.Column="1" Text="2 alertes" FontFamily="InterMedium" FontSize="13.5" TextColor="{StaticResource OnSurfaceVariant}" VerticalOptions="Center" />
                </Grid>

                <Border Style="{StaticResource Card}" Padding="16" StrokeShape="RoundRectangle 20">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="8">
                                <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="{StaticResource Amber}" VerticalOptions="Center" />
                                <Label Text="Signes de l'AVC (FAST)" FontFamily="InterBold" FontSize="17" />
                            </HorizontalStackLayout>
                            <Label Text="Protocole d'urgence et identification faciale" FontSize="14.5" TextColor="{StaticResource OnSurfaceVariant}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,4,0,0">
                                <c:Bar Progress="0.60" FillColor="{StaticResource Amber}" TrackColor="{StaticResource TrackBlue}" HeightRequest="8" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="60%" FontFamily="InterBold" FontSize="14" TextColor="#D97706" />
                            </Grid>
                        </VerticalStackLayout>
                        <Border Grid.Column="1" BackgroundColor="{StaticResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="16,12" VerticalOptions="Start" h:Nav.To="quiz">
                            <HorizontalStackLayout Spacing="6">
                                <c:Ico Name="restore" Size="19" TextColor="White" />
                                <Label Text="Réviser" FontFamily="InterBold" FontSize="15" TextColor="White" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16" StrokeShape="RoundRectangle 20">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="8">
                                <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="{StaticResource Error}" VerticalOptions="Center" />
                                <Label Text="Étouffement nourrisson" FontFamily="InterBold" FontSize="17" />
                            </HorizontalStackLayout>
                            <Label Text="Claques dorsales et compressions thoraciques" FontSize="14.5" TextColor="{StaticResource OnSurfaceVariant}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,4,0,0">
                                <c:Bar Progress="0.50" FillColor="{StaticResource Error}" TrackColor="{StaticResource TrackBlue}" HeightRequest="8" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="50%" FontFamily="InterBold" FontSize="14" TextColor="{StaticResource Error}" />
                            </Grid>
                        </VerticalStackLayout>
                        <Border Grid.Column="1" BackgroundColor="{StaticResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="16,12" VerticalOptions="Start" h:Nav.To="quiz">
                            <HorizontalStackLayout Spacing="6">
                                <c:Ico Name="restore" Size="19" TextColor="White" />
                                <Label Text="Réviser" FontFamily="InterBold" FontSize="15" TextColor="White" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Border>

                <!-- Badges -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Badges &amp; Trophées" FontFamily="InterBold" FontSize="19" />
                        <Label Text="4 débloqués sur 6" FontSize="14" TextColor="{StaticResource OnSurfaceVariant}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="Voir tout" FontFamily="InterBold" FontSize="14" TextColor="{StaticResource PrimaryDark}" VerticalOptions="Start" />
                </Grid>

                <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" BindableLayout.ItemsSource="{Binding Badges}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border FlexLayout.Basis="31.5%" BackgroundColor="{Binding CardBg}" Opacity="{Binding Fade}" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="8,16" Margin="0,0,0,10">
                                <VerticalStackLayout Spacing="8">
                                    <Border WidthRequest="68" HeightRequest="68" StrokeThickness="0" StrokeShape="RoundRectangle 34" BackgroundColor="{Binding IconBg}">
                                        <c:Ico Name="{Binding Icon}" Size="32" TextColor="{Binding IconFg}" />
                                    </Border>
                                    <Label Text="{Binding Name}" FontFamily="InterBold" FontSize="14" HorizontalTextAlignment="Center" />
                                    <Label Text="{Binding Status}" FontFamily="InterMedium" FontSize="13" TextColor="{Binding StatusColor}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Border Style="{StaticResource Card}" Padding="12" StrokeShape="RoundRectangle 20">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Border WidthRequest="98" HeightRequest="98" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                            <Image Source="milestone.png" Aspect="AspectFill" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="Prochain jalon" FontFamily="InterBold" FontSize="19" />
                            <Label Text="Termine 2 simulations d'urgence sans erreur pour valider l'insigne d'or." FontSize="14.5" TextColor="{StaticResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Style="{StaticResource PrimaryButton}" HeightRequest="58" h:Nav.To="quiz">
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                        <c:Ico Name="dumbbell" Size="24" TextColor="White" />
                        <Label Text="Lancer une révision ciblée (10 Q.)" FontFamily="InterBold" FontSize="16.5" TextColor="White" />
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <c:BottomNav Grid.Row="2" Active="progress" />
    </Grid>
</ContentPage>
