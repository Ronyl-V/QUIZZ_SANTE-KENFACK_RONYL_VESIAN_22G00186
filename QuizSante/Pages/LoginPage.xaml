<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:c="clr-namespace:QuizSante.Controls" xmlns:h="clr-namespace:QuizSante.Helpers" x:Class="QuizSante.Pages.LoginPage">
    <Grid RowDefinitions="Auto,*">
        <c:BackHeader Title="Connexion" BackRoute="register" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="22,18,22,28" Spacing="0">
                <Image Source="logo.png" WidthRequest="140" HeightRequest="112" Aspect="AspectFit" HorizontalOptions="Center" />

                <Border Style="{StaticResource Chip}" BackgroundColor="{StaticResource PrimaryContainer}"
                        HorizontalOptions="Center" Margin="0,6,0,14" Padding="12,6">
                    <HorizontalStackLayout Spacing="6">
                        <c:Ico Name="shield-check" Size="16" TextColor="{StaticResource PrimaryDark}" />
                        <Label Text="ESPACE MÉDICAL SÉCURISÉ" FontFamily="InterBold" FontSize="12" TextColor="{StaticResource PrimaryDark}" CharacterSpacing="0.4" />
                    </HorizontalStackLayout>
                </Border>

                <Label Text="Bon retour parmi nous" FontFamily="InterXBold" FontSize="28" HorizontalTextAlignment="Center" />
                <Label Text="Connectez-vous pour retrouver vos séries et vos fiches réflexes."
                       FontSize="16" TextColor="{StaticResource OnSurfaceVariant}" HorizontalTextAlignment="Center" Margin="10,8,10,22" />

                <Border Style="{StaticResource Card}" Padding="22">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Adresse email" FontFamily="InterBold" FontSize="14" Margin="0,0,0,8" />
                        <c:InputField Icon="email-outline" Placeholder="docteur.dupont@exemple.fr" KeyboardType="Email" />

                        <Grid ColumnDefinitions="*,Auto" Margin="0,18,0,8">
                            <Label Text="Mot de passe" FontFamily="InterBold" FontSize="14" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Mot de passe oublié ?" FontFamily="InterBold" FontSize="13"
                                   TextColor="{StaticResource PrimaryDark}" h:Nav.To="forgot" />
                        </Grid>
                        <c:InputField Icon="lock-outline" Placeholder="••••••••••••" IsPassword="True" />

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,18,0,0">
                            <Border x:Name="RememberBox" WidthRequest="26" HeightRequest="26" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 7" BackgroundColor="{StaticResource PrimaryDark}">
                                <c:Ico x:Name="RememberTick" Name="check" Size="18" TextColor="White" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRememberTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                            <Label Grid.Column="1" Text="Se souvenir de moi" FontSize="14.5" VerticalOptions="Center" />
                            <Border Grid.Column="2" Style="{StaticResource Chip}" BackgroundColor="{StaticResource GreenContainer}" HorizontalOptions="End" Padding="9,5">
                                <HorizontalStackLayout Spacing="5">
                                    <c:Ico Name="lock" Size="14" TextColor="{StaticResource Green}" />
                                    <Label Text="256-bit SSL" FontFamily="InterSemi" FontSize="12.5" TextColor="{StaticResource Green}" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource PrimaryButton}" Margin="0,20,0,0" h:Nav.To="home">
                            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="Se connecter" FontFamily="InterBold" FontSize="17" TextColor="White" />
                                <c:Ico Name="arrow-right" Size="20" TextColor="White" />
                            </HorizontalStackLayout>
                        </Border>

                        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="14" Margin="0,20,0,16">
                            <BoxView HeightRequest="1" Color="{StaticResource SecondaryContainer}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="OU CONTINUER AVEC" FontFamily="InterMedium" FontSize="12.5" TextColor="{StaticResource Outline}" CharacterSpacing="0.8" />
                            <BoxView Grid.Column="2" HeightRequest="1" Color="{StaticResource SecondaryContainer}" VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Border Style="{StaticResource SoftButton}">
                                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Image Source="google.png" WidthRequest="20" HeightRequest="20" />
                                    <Label Text="Google" FontFamily="InterBold" FontSize="15" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource SoftButton}">
                                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                                    <c:Ico Name="apple" Size="22" TextColor="Black" />
                                    <Label Text="Apple" FontFamily="InterBold" FontSize="15" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,22,0,0" h:Nav.To="register">
                    <Label Text="Pas encore de compte ?" FontSize="15" TextColor="{StaticResource OnSurfaceVariant}" VerticalOptions="Center" />
                    <Label Text="S'inscrire gratuitement" FontFamily="InterBold" FontSize="15" TextColor="{StaticResource PrimaryDark}" VerticalOptions="Center" />
                    <c:Ico Name="chevron-right" Size="18" TextColor="{StaticResource PrimaryDark}" />
                </HorizontalStackLayout>

                <Border Style="{StaticResource Chip}" BackgroundColor="{StaticResource SecondaryContainer}" HorizontalOptions="Center"
                        Margin="0,18,0,0" Padding="16,9" h:Nav.To="home">
                    <HorizontalStackLayout Spacing="8">
                        <c:Ico Name="wifi-off" Size="18" TextColor="{StaticResource OnSurfaceVariant}" />
                        <Label Text="Continuer en mode invité (hors-ligne)" FontFamily="InterSemi" FontSize="13.5" TextColor="{StaticResource OnSurfaceVariant}" />
                    </HorizontalStackLayout>
                </Border>

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,20,0,0">
                    <c:Ico Name="shield-half-full" Size="16" TextColor="{StaticResource Outline}" />
                    <Label Text="Données de santé conformes RGPD" FontSize="13" TextColor="{StaticResource Outline}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
