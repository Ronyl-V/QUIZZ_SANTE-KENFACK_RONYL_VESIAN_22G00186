<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:c="clr-namespace:QuizSante.Controls" xmlns:h="clr-namespace:QuizSante.Helpers" x:Class="QuizSante.Pages.VerifyCodePage">
    <Grid RowDefinitions="Auto,*">
        <c:BackHeader Title="Vérification Code Sécurité" BackRoute="forgot" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="22,14,22,28" Spacing="0">
                <Grid ColumnDefinitions="*,Auto">
                    <HorizontalStackLayout Spacing="2" VerticalOptions="Center" h:Nav.To="forgot">
                        <c:Ico Name="chevron-left" Size="20" TextColor="{StaticResource PrimaryDark}" />
                        <Label Text="Mot de passe oublié" FontFamily="InterBold" FontSize="15" TextColor="{StaticResource PrimaryDark}" />
                    </HorizontalStackLayout>
                    <Border Grid.Column="1" Style="{StaticResource Chip}" BackgroundColor="{StaticResource SecondaryContainer}" HorizontalOptions="End" Padding="10,6">
                        <HorizontalStackLayout Spacing="6">
                            <c:Ico Name="shield-check" Size="16" TextColor="{StaticResource PrimaryDark}" />
                            <Label Text="Protocole Sécurisé" FontFamily="InterBold" FontSize="12.5" TextColor="{StaticResource PrimaryDark}" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <Grid HorizontalOptions="Center" Margin="0,18,0,12" WidthRequest="112" HeightRequest="112">
                    <Border WidthRequest="98" HeightRequest="98" StrokeThickness="0" StrokeShape="RoundRectangle 26" BackgroundColor="{StaticResource Primary}"
                            HorizontalOptions="Start" VerticalOptions="Start">
                        <c:Ico Name="email-check-outline" Size="46" TextColor="White" />
                    </Border>
                    <Border WidthRequest="34" HeightRequest="34" StrokeThickness="2" Stroke="{StaticResource Surface}" StrokeShape="RoundRectangle 17"
                            BackgroundColor="{StaticResource Mint}" HorizontalOptions="End" VerticalOptions="End">
                        <c:Ico Name="check" Size="20" TextColor="{StaticResource OnMint}" />
                    </Border>
                </Grid>

                <Label Text="Vérification du code" FontFamily="InterXBold" FontSize="28" HorizontalTextAlignment="Center" />
                <Label HorizontalTextAlignment="Center" FontSize="15.5" TextColor="{StaticResource OnSurfaceVariant}" Margin="10,8,10,20">
                    <Label.FormattedText><FormattedString>
                        <Span Text="Un code à 6 chiffres a été envoyé à l'adresse " />
                        <Span Text="th***@email.com" FontFamily="InterBold" TextColor="{StaticResource OnSurface}" />
                        <Span Text="." />
                    </FormattedString></Label.FormattedText>
                </Label>

                <!-- Code à 6 chiffres : un Entry invisible capte la saisie, les 6 cases l'affichent -->
                <Border Style="{StaticResource Card}" Padding="18,18,18,16">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="CODE DE VALIDATION À 6 CHIFFRES" FontFamily="InterBold" FontSize="12.5" TextColor="{StaticResource OnSurfaceVariant}"
                               HorizontalTextAlignment="Center" CharacterSpacing="0.6" />
                        <Grid>
                            <Grid x:Name="CodeRow" ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="8" />
                            <Entry x:Name="CodeEntry" Keyboard="Numeric" MaxLength="6" Opacity="0.01" TextChanged="OnCodeChanged" />
                        </Grid>
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                            <c:Ico Name="timer-outline" Size="20" TextColor="{StaticResource OnSurfaceVariant}" />
                            <Label FontSize="14.5" TextColor="{StaticResource OnSurfaceVariant}" VerticalOptions="Center">
                                <Label.FormattedText><FormattedString>
                                    <Span Text="Renvoyer le code dans " />
                                    <Span x:Name="TimerSpan" Text="47s" FontFamily="InterBold" TextColor="{StaticResource PrimaryDark}" />
                                </FormattedString></Label.FormattedText>
                            </Label>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18" Margin="0,18,0,0">
                    <VerticalStackLayout Spacing="0">
                        <HorizontalStackLayout Spacing="12" Margin="0,0,0,16">
                            <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 22" BackgroundColor="{StaticResource PrimaryContainer}">
                                <c:Ico Name="lock-reset" Size="24" TextColor="{StaticResource PrimaryDark}" />
                            </Border>
                            <Label Text="Nouveau mot de passe" FontFamily="InterBold" FontSize="19" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Label Text="Mot de passe" FontFamily="InterBold" FontSize="14" Margin="0,0,0,8" />
                        <c:InputField x:Name="Pwd1" Icon="lock-outline" IsPassword="True" Text="Sante2026!" TextChanged="OnPwdChanged" />
                        <Label Text="Confirmez le mot de passe" FontFamily="InterBold" FontSize="14" Margin="0,16,0,8" />
                        <c:InputField x:Name="Pwd2" Icon="lock-clock" IsPassword="True" Text="Sante2026!" TextChanged="OnPwdChanged" />

                        <Border BackgroundColor="{StaticResource SurfaceContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="14,14" Margin="0,16,0,0">
                            <VerticalStackLayout Spacing="9">
                                <Label Text="CRITÈRES DE ROBUSTESSE" FontFamily="InterBold" FontSize="12.5" TextColor="{StaticResource OnSurfaceVariant}" CharacterSpacing="0.5" />
                                <HorizontalStackLayout Spacing="10"><c:Ico x:Name="Crit0" Name="check-circle" Size="22" TextColor="{StaticResource Mint}" /><Label Text="Au moins 8 caractères" FontSize="14.5" VerticalOptions="Center" /></HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="10"><c:Ico x:Name="Crit1" Name="check-circle" Size="22" TextColor="{StaticResource Mint}" /><Label Text="Une majuscule et une minuscule" FontSize="14.5" VerticalOptions="Center" /></HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="10"><c:Ico x:Name="Crit2" Name="check-circle" Size="22" TextColor="{StaticResource Mint}" /><Label Text="Un chiffre et un symbole (@, !, #, ...)" FontSize="14.5" VerticalOptions="Center" /></HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="10"><c:Ico x:Name="Crit3" Name="check-circle" Size="22" TextColor="{StaticResource Mint}" /><Label Text="Mots de passe identiques" FontSize="14.5" VerticalOptions="Center" /></HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource PrimaryButton}" Margin="0,20,0,0" h:Nav.To="home">
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="Confirmer et se connecter" FontFamily="InterBold" FontSize="17" TextColor="White" />
                        <c:Ico Name="login" Size="20" TextColor="White" />
                    </HorizontalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource SecondaryContainer}" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="12,10" Margin="0,12,0,0">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <c:Ico Name="help-circle-outline" Size="26" TextColor="{StaticResource Indigo}" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Un souci avec le code ?" FontFamily="InterBold" FontSize="14.5" />
                            <Label Text="Assistance clinique QuizSanté" FontSize="13.5" TextColor="{StaticResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14,10" VerticalOptions="Center">
                            <Label Text="Aide directe" FontFamily="InterBold" FontSize="13.5" TextColor="{StaticResource PrimaryDark}" />
                        </Border>
                    </Grid>
                </Border>

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8" Margin="0,24,0,0">
                    <Label Text="QUIZ SANTÉ" FontFamily="InterBold" FontSize="13" TextColor="{StaticResource Primary}" CharacterSpacing="1.2" />
                    <Label Text="•" TextColor="{StaticResource Outline}" />
                    <Label Text="SINCE 2026" FontFamily="InterBold" FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" CharacterSpacing="1.2" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
