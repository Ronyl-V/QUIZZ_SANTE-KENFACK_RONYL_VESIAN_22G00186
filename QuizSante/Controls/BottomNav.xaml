<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuizSante.Controls.BottomNav">
    <Border BackgroundColor="{StaticResource Surface}" StrokeThickness="0"
            StrokeShape="RoundRectangle 26,26,0,0" Padding="6,10,6,12">
        <Border.Shadow>
            <Shadow Brush="#0B1C30" Opacity="0.10" Radius="18" Offset="0,-4" />
        </Border.Shadow>
        <Grid x:Name="Row" ColumnDefinitions="*,*,*,*,*" />
    </Border>
</ContentView>
