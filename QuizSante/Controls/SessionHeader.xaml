<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:QuizSante.Controls"
             x:Class="QuizSante.Controls.SessionHeader">
    <Border BackgroundColor="{StaticResource Surface}" StrokeThickness="0" Padding="22,12">
        <Border.Shadow>
            <Shadow Brush="#0B1C30" Opacity="0.06" Radius="10" Offset="0,3" />
        </Border.Shadow>
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14" HeightRequest="44">
            <c:Ico x:Name="BackIcon" Name="arrow-left" Size="28" TextColor="{StaticResource OnSurface}" />
            <Label x:Name="TitleLabel" Grid.Column="1" Text="Session Quiz" FontFamily="InterMedium" FontSize="18" VerticalOptions="Center" />
            <c:Ico Grid.Column="2" Name="help-circle-outline" Size="26" TextColor="{StaticResource OnSurfaceVariant}" />
            <Border x:Name="AvatarBox" Grid.Column="3" WidthRequest="42" HeightRequest="42" StrokeThickness="0"
                    StrokeShape="RoundRectangle 21" BackgroundColor="{StaticResource PrimaryContainer}">
                <Label x:Name="AvatarLabel" FontFamily="InterBold" FontSize="14" TextColor="{StaticResource OnPrimaryContainer}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>
    </Border>
</ContentView>
