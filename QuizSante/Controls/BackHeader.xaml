<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:QuizSante.Controls"
             xmlns:h="clr-namespace:QuizSante.Helpers"
             x:Class="QuizSante.Controls.BackHeader">
    <Border BackgroundColor="{StaticResource Surface}" StrokeThickness="0" Padding="22,12">
        <Border.Shadow>
            <Shadow Brush="#0B1C30" Opacity="0.06" Radius="10" Offset="0,3" />
        </Border.Shadow>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" HeightRequest="44">
            <c:Ico x:Name="BackIcon" Name="arrow-left" Size="28" TextColor="{StaticResource OnSurface}" />
            <Label x:Name="TitleLabel" Grid.Column="1" FontFamily="InterMedium" FontSize="18" VerticalOptions="Center" />
            <Image Grid.Column="2" Source="logo.png" HeightRequest="38" WidthRequest="46" Aspect="AspectFit" />
        </Grid>
    </Border>
</ContentView>
