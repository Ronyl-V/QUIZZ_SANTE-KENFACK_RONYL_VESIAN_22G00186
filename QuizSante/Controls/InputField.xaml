<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:QuizSante.Controls"
             x:Class="QuizSante.Controls.InputField">
    <Border x:Name="Box" BackgroundColor="{StaticResource SurfaceContainer}" StrokeThickness="0"
            StrokeShape="RoundRectangle 14" HeightRequest="52" Padding="14,0">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <c:Ico x:Name="LeftIcon" Size="22" TextColor="{StaticResource OnSurfaceVariant}" />
            <Entry x:Name="Field" Grid.Column="1" VerticalOptions="Center" />
            <c:Ico x:Name="EyeIcon" Grid.Column="2" Name="eye-outline" Size="22"
                   TextColor="{StaticResource OnSurfaceVariant}" IsVisible="False">
                <c:Ico.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnEyeTapped" />
                </c:Ico.GestureRecognizers>
            </c:Ico>
        </Grid>
    </Border>
</ContentView>
