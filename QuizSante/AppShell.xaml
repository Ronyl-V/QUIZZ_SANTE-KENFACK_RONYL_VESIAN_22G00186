<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:QuizSante.Pages"
       x:Class="QuizSante.AppShell"
       FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False"
       Shell.TabBarIsVisible="False">

    <!-- Authentification -->
    <ShellContent Route="login"    ContentTemplate="{DataTemplate pages:LoginPage}" />
    <ShellContent Route="register" ContentTemplate="{DataTemplate pages:RegisterPage}" />
    <ShellContent Route="forgot"   ContentTemplate="{DataTemplate pages:ForgotPasswordPage}" />
    <ShellContent Route="verify"   ContentTemplate="{DataTemplate pages:VerifyCodePage}" />

    <!-- Navigation principale (barre du bas) -->
    <ShellContent Route="home"     ContentTemplate="{DataTemplate pages:HomePage}" />
    <ShellContent Route="catalog"  ContentTemplate="{DataTemplate pages:CatalogPage}" />
    <ShellContent Route="memos"    ContentTemplate="{DataTemplate pages:MemosPage}" />
    <ShellContent Route="progress" ContentTemplate="{DataTemplate pages:ProgressPage}" />
    <ShellContent Route="profile"  ContentTemplate="{DataTemplate pages:ProfilePage}" />

    <!-- Session de quiz et fiche détaillée -->
    <ShellContent Route="quiz"     ContentTemplate="{DataTemplate pages:QuizQuestionPage}" />
    <ShellContent Route="answer"   ContentTemplate="{DataTemplate pages:AnswerPage}" />
    <ShellContent Route="memo"     ContentTemplate="{DataTemplate pages:MemoDetailPage}" />
</Shell>
